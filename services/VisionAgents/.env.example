# Vision Agents Configuration
# Copy this file to .env and fill in your values

# Stream Video SDK (Required)
# Get these from https://getstream.io/dashboard/
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Google Gemini API (Required)
# Get this from https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key

# TeachingAssistant Service URL
TEACHING_ASSISTANT_URL=http://localhost:8002

# Video Processing Settings
VIDEO_FPS=2  # Frames per second for video analysis (lower = less CPU)

# Optional: ElevenLabs for TTS
# ELEVENLABS_API_KEY=your_elevenlabs_key

# Optional: Deepgram for STT
# DEEPGRAM_API_KEY=your_deepgram_key
