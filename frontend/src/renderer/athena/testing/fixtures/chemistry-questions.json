            "images": {}
          },
          {
            "content": "Put a 2 in front of $\\ce{H2}$:\n$$\\ce{2H2 + O2 -> 2H2O}$$\n\nBalanced! Left: 4 H, 2 O | Right: 4 H, 2 O",
            "widgets": {},
            "images": {}
          }
        ],
        "answerArea": { "type": "multiple" }
      }
