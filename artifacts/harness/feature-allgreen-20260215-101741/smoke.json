                        {
                          "clue": "Groundwater is found in many places and can be accessed through wells, making it a common water source.",
                          "content": "Groundwater is only found in remote, hard-to-reach locations, making it difficult to access for most populations.",
                          "isNoneOfTheAbove": false,
                          "correct": false,
                          "misconception": "Common student error"
