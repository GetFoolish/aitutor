                    "alignment": "default",
                    "graded": true,
                    "options": {
                      "choices": [
                        {
                          "content": "Deep underground aquifers, which hold a large percentage of Earth's liquid fresh water.",
                          "correct": true,
                          "misconception": null
                        },
                        {
                          "content": "Large freshwater lakes and rivers nearby, as they are visible and easy to access.",
                          "correct": false,
                          "misconception": "Overestimates the volume and reliability of surface fresh water."
                        },
                        {
                          "content": "Melting water from distant polar ice caps and glaciers, since they contain most of the world's fresh water.",
