                "size": "small"
              },
              "version": { "major": 0, "minor": 0 }
            },
            "numeric-input 2": {
              "type": "numeric-input",
              "graded": true,
              "options": {
                "answers": [{ "value": 2, "status": "correct" }],
                "size": "small"
              },
              "version": { "major": 0, "minor": 0 }
            }
          },
          "images": {}
        },
        "hints": [
          {
            "content": "Count atoms on each side:\n- Left: 2 H, 2 O\n- Right: 2 H, 1 O\n\nOxygen is unbalanced.",
            "widgets": {},
            "images": {}
          },
          {
            "content": "Put a 2 in front of $\\ce{H2O}$:\n$$\\ce{H2 + O2 -> 2H2O}$$\n\nNow: Left: 2 H, 2 O | Right: 4 H, 2 O",
