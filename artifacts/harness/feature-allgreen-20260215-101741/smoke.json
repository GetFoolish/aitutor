                  "definition 1": {
                    "alignment": "default",
                    "graded": false,
                    "options": {
                      "definition": "Water that is found beneath the Earth's surface, filling the spaces between soil particles and cracks in rocks. It is a vital source of drinking water for many communities, stored in underground layers called aquifers.",
