# ============================================================================
# TeachingAssistant Environment Variables
# Copy this file to .env and fill in your values
# ============================================================================

# ============================================================================
# REQUIRED - Must be set for the system to work
# ============================================================================

# MongoDB Atlas Connection String
# Get from: Atlas UI → Database → Connect → Drivers → Copy connection string
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/ai_tutor?retryWrites=true&w=majority

# Google/Gemini API Key (for embeddings and LLM)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# JWT Secret for authentication (any random string)
JWT_SECRET=your_random_secret_string_here_make_it_long

# ============================================================================
# IMPORTANT - Should match your MongoDB Atlas Vector Index
# ============================================================================

# Embedding dimension - MUST match your Atlas vector index
# Default: 768 (Gemini text-embedding-004)
EMBEDDING_DIMENSION=768

# ============================================================================
# OPTIONAL - Defaults are fine for testing
# ============================================================================

# MongoDB Settings
MONGODB_DB_NAME=ai_tutor
MONGODB_MEMORY_DB=ai_tutor
MONGODB_MEMORY_COLLECTION=memories

# Server Settings
TEACHING_ASSISTANT_PORT=8002

# Memory System Settings
MEMORY_SIMILARITY_THRESHOLD=0.92
MEMORY_MIN_WORD_COUNT=3
MEMORY_WEIGHT_SIMILARITY=0.6
MEMORY_WEIGHT_RECENCY=0.3
MEMORY_WEIGHT_IMPORTANCE=0.1
MEMORY_RECENCY_DECAY_HOURS=24.0
MEMORY_MAX_COUNTER_FREQUENCY=10

# Feature Flags (all enabled by default)
ENABLE_BIOGRAPHER=true
ENABLE_MEMORY_EXTRACTION=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_SKILLS=true

# Session Settings
SESSION_TIMEOUT_MINUTES=30
MAX_CONVERSATION_HISTORY=50

# Biography Settings
BIOGRAPHY_MIN_WORDS=50
BIOGRAPHY_MAX_WORDS=500

# Gemini Model (optional - uses default if not set)
GEMINI_TEXT_MODEL=gemini-1.5-flash

# ============================================================================
# NOT NEEDED - Pinecone has been replaced with MongoDB
# ============================================================================
# PINECONE_API_KEY=not_needed
# PINECONE_ENVIRONMENT=not_needed
# PINECONE_INDEX_NAME=not_needed
