# =================================
# AI TUTOR - Environment Variables
# =================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# =================================
# OPENROUTER (Required for Video Search)
# =================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# =================================
# GOOGLE APIs (Required)
# =================================
YOUTUBE_API_KEY=your_youtube_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash-native-audio-preview-09-2025
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# =================================
# MONGODB (Required)
# =================================
MONGODB_URI=mongodb://localhost:27017/ai_tutor
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai_tutor?retryWrites=true&w=majority
MONGODB_DB_NAME=ai_tutor

# =================================
# AUTHENTICATION (Required)
# =================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_secure_random_secret_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# =================================
# PAYMENTS (Stripe - Optional)
# =================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =================================
# IMAGEKIT (Optional)
# =================================
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# =================================
# VECTOR DB - Pinecone (Optional)
# =================================
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=aitutor
EMBEDDING_DIMENSION=1024

# =================================
# VIMEO (Optional)
# =================================
VIMEO_API_KEY=your_vimeo_key_optional

# =================================
# DAILY.CO (Required for Voice AI)
# =================================
DAILY_API_KEY=your_daily_api_key
DAILY_ROOM_URL=https://yourdomain.daily.co/roomname

# =================================
# AZURE STORAGE (For Question Bank Generator)
# =================================
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string

# =================================
# API CONFIGURATION
# =================================
API_BASE_URL=http://localhost:8001/api
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# =================================
# SERVICE PORTS (Default - Change if needed)
# =================================
AUTH_SERVICE_PORT=8003
HOMEWORK_SERVICE_PORT=8004
FRONTEND_PORT=3000

# =================================
# CORS CONFIGURATION (Development)
# =================================
# Leave empty for development defaults
# For production, set specific origins:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =================================
# OTHER SETTINGS
# =================================
SAVE_LOCAL_JSON_BACKUP=False
MAX_QUESTIONS=10
REQUEST_DELAY_SECONDS=1.5
IMAGE_SIZE=256
