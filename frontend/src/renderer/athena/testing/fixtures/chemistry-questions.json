    {
      "id": "chem-molar-mass-1",
      "title": "Calculating Molar Mass",
      "subject": "Chemistry",
      "topic": "Stoichiometry",
      "perseusFormat": {
        "question": {
          "content": "Calculate the molar mass of water ($\\ce{H2O}$).\n\nGiven:\n- Atomic mass of H = $\\pu{1.008 g/mol}$\n- Atomic mass of O = $\\pu{16.00 g/mol}$\n\nMolar mass of $\\ce{H2O}$ = [[☃ numeric-input 1]] $\\pu{g/mol}$",
          "widgets": {
            "numeric-input 1": {
              "type": "numeric-input",
              "graded": true,
              "options": {
                "answers": [
                  { "value": 18.016, "status": "correct", "maxError": 0.01 },
                  { "value": 18.02, "status": "correct", "maxError": 0.01 },
                  { "value": 18, "status": "correct", "maxError": 0.1 }
                ],
                "size": "normal"
              },
              "version": { "major": 0, "minor": 0 }
            }
          },
          "images": {}
        },
        "hints": [
          {
            "content": "Water ($\\ce{H2O}$) contains:\n- 2 hydrogen atoms\n- 1 oxygen atom",
            "widgets": {},
            "images": {}
          },
          {
            "content": "Molar mass = (2 × 1.008) + (1 × 16.00)\n           = 2.016 + 16.00\n           = $\\pu{18.016 g/mol}$",
            "widgets": {},
            "images": {}
          }
        ],
        "answerArea": { "type": "single" }
      }
    },
