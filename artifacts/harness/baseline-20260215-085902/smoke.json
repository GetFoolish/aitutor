          "question": {
            "question": {
              "content": "Sunlight is the primary source of energy for almost all living things on Earth. In a forest ecosystem, how is this solar energy transformed and utilized by different organisms to sustain life? Select TWO correct answers.\n\n[[\u2603 radio 1]]",
              "images": {},
              "widgets": {
                "radio 1": {
                  "alignment": "default",
                  "graded": true,
                  "options": {
                    "choices": [
                      {
                        "content": "Plants capture light energy from the sun and convert it into chemical energy stored in sugars through photosynthesis.",
                        "correct": true,
                        "misconception": null
                      },
                      {
                        "content": "Animals consume plants or other animals, breaking down the stored chemical energy in food to power their body functions.",
                        "correct": true,
                        "misconception": null
                      },
                      {
                        "content": "Decomposers generate new energy from decaying matter, which then directly fuels plant growth.",
                        "correct": false,
                        "misconception": "Confuses energy recycling with matter recycling; implies energy creation from decay."
                      },
                      {
                        "content": "All organisms directly absorb sunlight through their skin or leaves to generate the heat they need to survive.",
