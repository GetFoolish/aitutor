[{"question":{"content":"How many basic consonant letters are there in Hangeul (the Korean alphabet)? [[☃ radio 1]]","images":{},"widgets":{"radio 1":{"type":"radio","graded":true,"options":{"multipleSelect":false,"choices":[{"content":"5","correct":false,"misconception":"Common student error"},{"content":"14","correct":true,"misconception":null},{"content":"26","correct":false,"misconception":"Common student error"},{"content":"10","correct":false,"misconception":"Common student error"}],"countChoices":false,"deselectEnabled":false,"displayCount":null,"hasNoneOfTheAbove":false,"randomize":false,"numCorrect":1},"version":{"major":2,"minor":0},"alignment":"default","static":false}}},"answerArea":{"calculator":false,"type":"multiple"},"hints":[{"content":"Think about the basic sounds in Korean.","images":{},"replace":false,"widgets":{}},{"content":"Hangeul has 14 basic consonant letters and 10 basic vowel letters.","images":{},"replace":false,"widgets":{}},{"content":"The correct answer is 14.","images":{},"replace":false,"widgets":{}}],"itemDataVersion":null,"dash_metadata":{"dash_question_id":"ai_q_f425c5789981","skill_ids":["ai_gen_korean_us_6-8th-grade-korean-novice-low-proficiency_unit_mastering-hangeul"],"difficulty":0.5,"skill_names":["Mastering Hangeul: The Korean Alphabet"],"unit_name":"Mastering Hangeul: The Korean Alphabet","lesson_name":"Practice","ai_generated":true,"mongodb_id":"6990b57c7f832a69b006874d"}},{"question":{"content":"[[☃ image 1]]\n\nSora says \"안녕하세요! 이름이 뭐예요?\" (Annyeonghaseyo! Ireumi mwoyeyo?). Minji wants to politely introduce herself and say, \"My name is Minji.\" What should Minji say?\n\n[[☃ radio 1]]","images":{},"widgets":{"radio 1":{"alignment":"default","graded":true,"options":{"choices":[{"content":"저는 민지입니다. (Jeoneun Minji-imnida.)","correct":true,"misconception":null},{"content":"민지입니다. (Minji-imnida.)","correct":false,"misconception":"Omitting the subject '저는' (jeoneun) for a complete introduction."},{"content":"안녕하세요, 민지. (An